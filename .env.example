# Environment Variables

## Required for Formspree contact form
NEXT_PUBLIC_FORMSPREE_ID=       # Get from formspree.io after creating a form

## Analytics (optional)
NEXT_PUBLIC_GA_ID=              # Google Analytics G-XXXXXXXXXX measurement ID

## Site URL (update before production deploy)
NEXT_PUBLIC_SITE_URL=https://qooiksolutions.com

## Business Contact Info (already hardcoded in siteConfig, override here if needed)
# NEXT_PUBLIC_WA_NUMBER=918928244779
# NEXT_PUBLIC_CONTACT_EMAIL=qooiksolutions@gmail.com
# NEXT_PUBLIC_CONTACT_PHONE=+918928244779
